# Copy to deploy/.env and fill in. These are the ONLY values needed before first boot;
# everything else is configured in the web onboarding wizard.

# Base64-encoded 32-byte master key for envelope encryption of stored secrets.
# Generate one with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret authorizing the worker→web leg of the assisted-login relay
# (docs/design/cdp-relay.md). Any long random string; generate one with:  openssl rand -hex 32
RELAY_TOKEN=

# Port the web portal listens on (host side).
PORT=8080

# For LOCAL (non-Docker) development only — inside Docker Compose this is set automatically
# to the bundled postgres service. Uncomment for local dev:
# DATABASE_URL=postgres://uc:uc@localhost:5432/uc

# Optional: CloakBrowser Pro license key (latest Chromium + newest anti-bot patches).
# Leave empty to use the free v146 binary, which is auto-downloaded into the worker image.
# CLOAKBROWSER_LICENSE_KEY=
