# Automation worker. Runs CloakBrowser (source-patched Chromium) HEADED under Xvfb on a
# headless host. x86_64 only.
FROM node:20-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN corepack pnpm install --frozen-lockfile
# Building the worker also builds its referenced workspace packages (tsc -b).
RUN corepack pnpm --filter @uc/worker build

FROM node:20-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable

# System deps: Xvfb (virtual display) + every shared library this Chromium links against.
# The list is deliberately complete rather than minimal: an incomplete one fails only at the
# first browser launch, with "error while loading shared libraries" buried in a launch log — the
# original list was missing libcairo/libpango/GTK and every claim died on a headless host.
# The `ldd` check below turns a missing library into a build failure instead.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth ca-certificates fonts-liberation \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libgtk-3-0 libglib2.0-0 libx11-6 libxcb1 libxext6 \
    libxi6 libxtst6 libexpat1 libdbus-1-3 libudev1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app ./

# Pre-download the CloakBrowser binary at build time so the finished image ships with it and
# the first claim isn't slowed by a ~200MB download. The binary is fetched from CloakHQ's
# official source by the operator's own build (not redistributed by this project); the free
# v146 binary is licensed for personal + commercial self-hosted use.
ENV CLOAKBROWSER_CACHE_DIR=/opt/cloakbrowser
# For CloakBrowser Pro (latest Chromium), pass a license key at build:
#   docker build --build-arg CLOAKBROWSER_LICENSE_KEY=cb_xxx ...
ARG CLOAKBROWSER_LICENSE_KEY=""
RUN CLOAKBROWSER_LICENSE_KEY="$CLOAKBROWSER_LICENSE_KEY" \
    corepack pnpm --filter @uc/connectors exec cloakbrowser install

# Fail the build — not the first claim — if the bundled Chromium is missing a library.
RUN CHROME="$(find /opt/cloakbrowser -name chrome -type f | head -1)" \
    && echo "checking $CHROME" \
    && ! ldd "$CHROME" | grep "not found" \
    && "$CHROME" --headless=new --no-sandbox --dump-dom about:blank > /dev/null \
    && echo "chromium launches"

ENV DISPLAY=:99
# Start Xvfb ourselves and `exec` the worker, rather than wrapping it in `xvfb-run`.
# xvfb-run swallowed the worker's stdout, so `docker logs` showed nothing at all — on a headless
# NAS that leaves the operator with no way to diagnose anything. exec'ing also makes node PID 1's
# process, so `docker stop` delivers SIGTERM to the worker instead of to a wrapper script.
# The short wait lets the display socket appear before the first browser launch.
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x800x24 -nolisten tcp >/tmp/xvfb.log 2>&1 & \
for i in $(seq 1 50); do [ -e /tmp/.X11-unix/X99 ] && break; sleep 0.1; done; \
exec node apps/worker/dist/index.js"]
