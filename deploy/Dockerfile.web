# Web portal (Next.js + custom server for the relay WebSocket). Multi-stage: build with pnpm,
# then run the custom server. Not using Next `standalone` output because the CDP relay needs a
# custom Node server (docs/design/cdp-relay.md) that accepts the WebSocket upgrade in-process.
FROM node:20-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN corepack pnpm install --frozen-lockfile
# Build the web app and the workspace packages it depends on.
RUN corepack pnpm --filter "@uc/web..." build

FROM node:20-bookworm-slim AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
# Copy the whole built workspace (node_modules + packages' dist + the web .next build). The
# custom server requires node_modules at runtime (next, ws, @uc/*), so standalone tracing is
# not used here.
COPY --from=build /app ./
EXPOSE 8080
ENV PORT=8080
ENV HOST=0.0.0.0
# Migrations are applied by the app on startup; see @uc/db runMigrations.
CMD ["node", "apps/web/server.mjs"]
