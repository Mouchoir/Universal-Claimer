{
  "manifest_version": 3,
  "name": "Universal Claimer — Session Exporter",
  "version": "0.1.0",
  "description": "Export your logged-in session cookies locally to connect an account in your self-hosted Universal Claimer. Never sends your data anywhere.",
  "permissions": ["cookies", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://*.epicgames.com/*",
    "https://*.microsoft.com/*",
    "https://*.live.com/*",
    "https://*.bing.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.se/*",
    "https://*.amazon.pl/*",
    "https://*.amazon.com.be/*",
    "https://*.amazon.ie/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.in/*",
    "https://*.amazon.sg/*",
    "https://*.amazon.ae/*",
    "https://*.amazon.sa/*",
    "https://*.amazon.com.tr/*",
    "https://*.amazon.eg/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal Claimer Session Exporter"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-claimer-session-exporter@mouchoir.github.io",
      "strict_min_version": "115.0"
    }
  }
}
